---
export interface Props {
  locationSlug: string;
  label?: string;
  coordinates?: { lat: number; lng: number };
  deepLinkParams?: Record<string, string>;
  description?: string;
  class?: string;
}

const {
  locationSlug,
  label = 'Explore Geological Location on GeoMap',
  coordinates,
  deepLinkParams = {},
  description,
  class: className = '',
} = Astro.props;

// Configurable external GeoMap URL
const GEOMAP_BASE_URL = 'https://harrys752.github.io/GeoMap-New/';

// Build deep link
const queryParams = new URLSearchParams({
  location: locationSlug,
  ...deepLinkParams,
});

if (coordinates) {
  queryParams.set('lat', coordinates.lat.toString());
  queryParams.set('lng', coordinates.lng.toString());
}

const fullUrl = `${GEOMAP_BASE_URL}?${queryParams.toString()}`;
---

<div class={`rounded-xl border border-[var(--color-interactive)]/30 bg-[var(--color-interactive-subtle)]/40 p-5 transition-all duration-200 hover:border-[var(--color-interactive)] hover:shadow-md ${className}`}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-[var(--color-interactive)] text-white flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
            <line x1="9" y1="3" x2="9" y2="18" />
            <line x1="15" y1="6" x2="15" y2="21" />
          </svg>
        </div>
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-interactive)] font-semibold">
          GeoMap Indonesia Connection
        </span>
      </div>

      <h4 class="text-base font-bold text-[var(--color-text)]">
        {label}
      </h4>

      {description && (
        <p class="text-xs text-[var(--color-text-muted)] max-w-xl leading-relaxed">
          {description}
        </p>
      )}

      {coordinates && (
        <div class="text-[11px] font-mono text-[var(--color-text-dim)]">
          Coordinates: {coordinates.lat}°N, {coordinates.lng}°E
        </div>
      )}
    </div>

    <a
      href={fullUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--color-interactive)] text-white text-xs font-semibold hover:bg-[var(--color-interactive-hover)] transition-all shrink-0 shadow-sm focus-visible:ring-2 focus-visible:ring-[var(--color-interactive)]"
      title="Opens external GeoMap Indonesia exploration interface"
    >
      <span>Inspect on GeoMap</span>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        <polyline points="15 3 21 3 21 9" />
        <line x1="10" y1="14" x2="21" y2="3" />
      </svg>
    </a>
  </div>
</div>

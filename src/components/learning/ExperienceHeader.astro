---
import Badge from '../ui/Badge.astro';
import Breadcrumb from '../ui/Breadcrumb.astro';
import type { ScientificMetadata } from '../../types/content';
import { withBase } from '../../lib/url';

export interface Props {
  title: string;
  tagline?: string;
  topicTitle: string;
  topicSlug: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  estimatedTime: '5min' | '10min' | '20min' | '30plus';
  scientific?: ScientificMetadata;
  class?: string;
}

const {
  title,
  tagline,
  topicTitle,
  topicSlug,
  difficulty,
  estimatedTime,
  scientific,
  class: className = '',
} = Astro.props;

const breadcrumbItems = [
  { label: 'Explore', href: '/explore' },
  { label: topicTitle, href: `/explore/topics/${topicSlug}` },
  { label: title, current: true },
];
---

<header class={`border-b border-[var(--color-border)] pb-8 mb-8 ${className}`}>
  <Breadcrumb items={breadcrumbItems} class="mb-4" />

  <div class="space-y-4">
    <div class="flex items-center gap-2 flex-wrap text-xs">
      <a
        href={withBase(`/explore/topics/${topicSlug}`)}
        class="font-semibold uppercase tracking-wider text-[var(--color-accent)] hover:underline"
      >
        {topicTitle}
      </a>
      <span class="text-[var(--color-border)]">•</span>
      <Badge variant={difficulty}>{difficulty}</Badge>
      <Badge variant="time">{estimatedTime}</Badge>

      {scientific && (
        <span
          class="px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-[var(--color-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-muted)] inline-flex items-center gap-1"
          title={`Source: ${scientific.source.join(', ')} • Confidence: ${scientific.confidence}`}
        >
          <svg class="w-3 h-3 text-[var(--color-secondary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
          <span class="capitalize">{scientific.sourceType.replace('-', ' ')}</span>
        </span>
      )}
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-text)] tracking-tight leading-tight">
      {title}
    </h1>

    {tagline && (
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] max-w-3xl leading-relaxed">
        {tagline}
      </p>
    )}
  </div>
</header>

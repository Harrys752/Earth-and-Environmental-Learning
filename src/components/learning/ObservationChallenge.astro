---
import Button from '../ui/Button.astro';
import { useTranslations } from '../../i18n';
import { getLocalizedUrl, type Locale } from '../../lib/i18nUrl';

export interface Props {
  title: string;
  targetPhenomenon: string;
  observationSteps: string[];
  whatToLookFor: string;
  experienceSlug: string;
  locale?: Locale;
  class?: string;
}

const {
  title,
  targetPhenomenon,
  observationSteps,
  whatToLookFor,
  experienceSlug,
  locale = 'en',
  class: className = '',
} = Astro.props;

const t = useTranslations(locale);
const logHref = getLocalizedUrl(`/journey/timeline?action=new&type=observation&experience=${experienceSlug}&title=${encodeURIComponent(title)}`, locale);
---

<div
  class={`rounded-2xl border border-[var(--color-warning)]/30 bg-[var(--color-warning-subtle)]/30 p-6 sm:p-7 space-y-4 my-8 ${className}`}
>
  <div class="flex items-center gap-2">
    <div class="w-8 h-8 rounded-lg bg-[var(--color-warning)] text-white flex items-center justify-center font-bold text-sm">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M2 12h20" />
        <path d="M20 12v8H4v-8" />
        <path d="m4 4 16 16" />
      </svg>
    </div>
    <div>
      <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-warning)] font-bold">
        {t.observationChallenge.heading}
      </span>
      <h3 class="text-base sm:text-lg font-bold text-[var(--color-text)]">
        {title}
      </h3>
    </div>
  </div>

  <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
    <strong class="text-[var(--color-text)] font-semibold">{t.observationChallenge.targetPhenomenon} </strong>
    {targetPhenomenon}
  </p>

  <div class="space-y-2 pt-1">
    <span class="text-xs font-semibold text-[var(--color-text)] block">
      {t.observationChallenge.observationalProtocol}
    </span>
    <ol class="space-y-1.5 list-decimal list-inside text-xs text-[var(--color-text-muted)]">
      {observationSteps.map((step) => (
        <li class="leading-relaxed">{step}</li>
      ))}
    </ol>
  </div>

  <div class="rounded-xl bg-[var(--color-surface)] p-3.5 border border-[var(--color-border)] text-xs text-[var(--color-text)]">
    <strong class="text-[var(--color-warning)] font-semibold">{t.observationChallenge.diagnosticClue} </strong>
    {whatToLookFor}
  </div>

  <div class="pt-2 flex items-center justify-between flex-wrap gap-2 text-xs">
    <span class="text-[var(--color-text-dim)]">
      {t.observationChallenge.habitNotice}
    </span>
    <Button
      href={logHref}
      variant="outline"
      size="sm"
    >
      {t.observationChallenge.logButton}
    </Button>
  </div>
</div>

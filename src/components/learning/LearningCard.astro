---
import Badge from '../ui/Badge.astro';
import { getLocalizedUrl, type Locale } from '../../lib/i18nUrl';
import { useTranslations } from '../../i18n';

export interface Props {
  id: string;
  slug: string;
  title: string;
  tagline?: string;
  description: string;
  topic: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  estimatedTime: '5min' | '10min' | '20min' | '30plus';
  hasInteractive?: boolean;
  hasGeoMap?: boolean;
  isIndonesiaFirst?: boolean;
  locale?: string;
  class?: string;
}

const {
  slug,
  title,
  tagline,
  description,
  topic,
  difficulty,
  estimatedTime,
  hasInteractive = true,
  hasGeoMap = false,
  isIndonesiaFirst = false,
  locale = 'en',
  class: className = '',
} = Astro.props;

const currentLocale: Locale = (locale as Locale) || 'en';
const t = useTranslations(currentLocale);
const expHref = getLocalizedUrl(`/learn/${slug}`, currentLocale);
const isUntranslated = currentLocale === 'id' && slug !== 'why-volcanoes-form';
---

<article
  class={`group relative rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 sm:p-6 transition-all duration-200 hover:border-[var(--color-accent)]/50 hover:shadow-lg flex flex-col justify-between ${className}`}
>
  <div>
    {/* Header Badges */}
    <div class="flex items-center justify-between gap-2 flex-wrap mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-dim)]">
        {topic}
      </span>
      <div class="flex items-center gap-1.5 flex-wrap">
        {isUntranslated && (
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-amber-100 dark:bg-amber-950 text-amber-900 dark:text-amber-200 border border-amber-300 dark:border-amber-800" title={t.common.untranslatedBadgeLabel}>
            {t.common.untranslatedBadge}
          </span>
        )}
        <Badge variant={difficulty}>{t.cards.difficulty[difficulty] || difficulty}</Badge>
        <Badge variant="time">{t.cards.time[estimatedTime] || estimatedTime}</Badge>
      </div>
    </div>

    {/* Title & Description */}
    <h3 class="text-lg font-bold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors leading-snug mb-2">
      <a href={expHref} class="focus:outline-none focus-visible:underline">
        <span class="absolute inset-0" aria-hidden="true" />
        {title}
      </a>
    </h3>

    {tagline && (
      <p class="text-xs font-medium text-[var(--color-accent)] mb-2">
        {tagline}
      </p>
    )}

    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] line-clamp-3 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  {/* Footer Features */}
  <div class="pt-4 border-t border-[var(--color-border)] flex items-center justify-between text-xs text-[var(--color-text-dim)]">
    <div class="flex items-center gap-2">
      {hasInteractive && (
        <span class="inline-flex items-center gap-1 text-[var(--color-accent)] font-medium">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
          <span>{t.cards.interactiveModel}</span>
        </span>
      )}
      {hasGeoMap && (
        <span class="inline-flex items-center gap-1 text-[var(--color-interactive)] font-medium">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
          </svg>
          <span>{t.cards.geoMapLinked}</span>
        </span>
      )}
      {isIndonesiaFirst && (
        <span class="inline-flex items-center gap-1 text-[var(--color-secondary)] font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-secondary)]" />
          <span>{t.cards.indonesiaFirst}</span>
        </span>
      )}
    </div>

    <span class="inline-flex items-center gap-1 text-[var(--color-text)] font-semibold group-hover:translate-x-0.5 transition-transform">
      <span>{t.cards.openExperience}</span>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    </span>
  </div>
</article>

---
export interface Props {
  href?: string;
  class?: string;
  elevated?: boolean;
  interactive?: boolean;
  id?: string;
}

const {
  href,
  class: className = '',
  elevated = false,
  interactive = false,
  id,
  ...rest
} = Astro.props;

const baseClass = 'block rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all duration-200';
const elevatedClass = elevated ? 'shadow-md' : 'shadow-sm';
const interactiveClass = interactive || href
  ? 'hover:border-[var(--color-accent)]/50 hover:shadow-md hover:translate-y-[-2px] cursor-pointer'
  : '';

const combinedClass = `${baseClass} ${elevatedClass} ${interactiveClass} ${className}`;
---

{
  href ? (
    <a href={href} class={combinedClass} id={id} {...rest}>
      <slot />
    </a>
  ) : (
    <div class={combinedClass} id={id} {...rest}>
      <slot />
    </div>
  )
}

---
import { withBase } from '../../lib/url';

export interface BreadcrumbItem {
  label: string;
  href?: string;
  current?: boolean;
}

export interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`flex items-center text-xs text-[var(--color-text-muted)] py-2 ${className}`}>
  <ol class="flex items-center flex-wrap gap-1.5 list-none m-0 p-0">
    <li class="flex items-center gap-1.5">
      <a
        href={withBase('/')}
        class="hover:text-[var(--color-text)] transition-colors inline-flex items-center gap-1 focus-visible:ring-1 focus-visible:ring-[var(--color-accent)] rounded"
      >
        <svg class="w-3.5 h-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Earth Sciences</span>
      </a>
    </li>

    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        const targetUrl = item.href ? withBase(item.href) : undefined;
        return (
          <li class="flex items-center gap-1.5">
            <span class="text-[var(--color-border)] select-none" aria-hidden="true">/</span>
            {isLast || item.current ? (
              <span
                class="font-medium text-[var(--color-text)] truncate max-w-[200px] sm:max-w-xs"
                aria-current="page"
              >
                {item.label}
              </span>
            ) : (
              <a
                href={targetUrl}
                class="hover:text-[var(--color-text)] transition-colors truncate max-w-[150px] focus-visible:ring-1 focus-visible:ring-[var(--color-accent)] rounded"
              >
                {item.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

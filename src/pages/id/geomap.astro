---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { GEOMAP_BASE_URL, buildGeoMapUrl } from '../../lib/geomap';
import { withBase } from '../../lib/url';

const breadcrumbItems = [
  { label: 'Jembatan GeoMap', current: true },
];

const featuredLocations = [
  {
    slug: 'java-volcanic-arc',
    name: 'Busur Vulkanik Jawa & Gunung Merapi',
    coords: '-7.54°LS, 110.45°BT',
    context: 'Zona subduksi aktif, rangkaian stratovulkanik, dan antarmuka bahaya bencana populasi padat.',
  },
  {
    slug: 'karangsambung-geopark',
    name: 'Geopark Karangsambung (Sungai Luk Ulo)',
    coords: '-7.56°LS, 109.68°BT',
    context: 'Melange tektonik purba zaman Kapur dengan singkapan basal bantal, rijang merah, dan sekis biru bertekanan tinggi.',
  },
  {
    slug: 'bogor-rain-belt',
    name: 'Sabuk Hujan Orografis Bogor',
    coords: '-6.60°LS, 106.81°BT',
    context: 'Konveksi maritim khatulistiwa yang membentur medan vulkanik, menghasilkan curah hujan lebih dari 4.000 mm per tahun.',
  },
  {
    slug: 'sangiran-valley',
    name: 'Lembah Manusia Purba Sangiran',
    coords: '-7.46°LS, 110.83°BT',
    context: 'Stratigrafi sedimen daratan yang menyimpan 2 juta tahun rekaman fosil hominid dan mamalia Pleistosen.',
  },
];
---

<BaseLayout
  title="Jembatan GeoMap Indonesia — Eksplorasi Kebumian Kontekstual"
  description="Halaman penghubung antara pengalaman belajar Ilmu Kebumian & Lingkungan dengan platform eksplorasi eksternal GeoMap Indonesia 2.0."
  locale="id"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    <Breadcrumb items={breadcrumbItems} />

    <header class="border-b border-[var(--color-border)] pb-8 space-y-3">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-interactive)]" />
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-interactive)] font-bold">
          Titik Integrasi Platform Eksternal
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-text)] tracking-tight">
        Jembatan GeoMap Indonesia 2.0
      </h1>

      <p class="text-base sm:text-lg text-[var(--color-text-muted)] max-w-3xl leading-relaxed">
        GeoMap Indonesia adalah platform eksplorasi geospasial eksternal yang dikembangkan secara independen. Platform Pembelajaran ini menautkan secara kontekstual ke koordinat GeoMap tanpa ketergantungan wajib atau bingkai tersemat, menjaga privasi pengguna dan kemandirian platform.
      </p>

      <div class="pt-2">
        <a
          href={GEOMAP_BASE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--color-interactive)] text-white text-sm font-semibold hover:bg-[var(--color-interactive-hover)] transition-all shadow-sm"
        >
          <span>Buka GeoMap Indonesia 2.0 (Eksternal)</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </a>
      </div>
    </header>

    <!-- Architecture & Integration Relationship Disclosure (§8.1) -->
    <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] space-y-3">
      <h3 class="text-sm font-bold uppercase tracking-wider font-mono text-[var(--color-text)]">
        Arsitektur Integrasi Teknis
      </h3>
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
        Sesuai dengan prinsip arsitektur inti kami, platform pembelajaran ini beroperasi penuh tanpa keberadaan GeoMap, dan GeoMap beroperasi penuh tanpa platform ini. Keduanya terhubung semata-mata melalui <strong class="text-[var(--color-text)]">tautan eksternal kontekstual dan parameter koordinat geospasial terstandarisasi</strong>.
      </p>
    </div>

    <!-- Curated Field Localities Grid -->
    <section class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-[var(--color-text)]">
          Titik Lokasi Lapangan Pilihan
        </h2>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1">
          Koordinat langsung ke lokasi lapangan geologi Indonesia yang dieksplorasi dalam materi belajar kami.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {featuredLocations.map((loc) => (
          <div class="p-5 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-interactive)] transition-all space-y-3 flex flex-col justify-between">
            <div class="space-y-1.5">
              <span class="text-[10px] font-mono font-semibold text-[var(--color-interactive)] block">
                {loc.coords}
              </span>
              <h4 class="text-base font-bold text-[var(--color-text)]">
                {loc.name}
              </h4>
              <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
                {loc.context}
              </p>
            </div>

            <div class="pt-3 border-t border-[var(--color-border)] flex items-center justify-between">
              <a
                href={withBase('/id/learn/why-volcanoes-form')}
                class="text-xs text-[var(--color-text-dim)] hover:underline"
              >
                Konsep Terkait →
              </a>

              <a
                href={buildGeoMapUrl({ locationSlug: loc.slug })}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--color-interactive)] hover:underline"
              >
                <span>Lihat di GeoMap</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

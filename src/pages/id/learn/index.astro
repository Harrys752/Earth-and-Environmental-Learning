---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import LearningCard from '../../../components/learning/LearningCard.astro';
import Button from '../../../components/ui/Button.astro';

const rawExperiences = await getCollection('experiences');

const experiences = rawExperiences.filter((exp) => {
  const isId = exp.id.startsWith('id/');
  return isId || !rawExperiences.some((e) => e.id === `id/${exp.id}`);
});

const breadcrumbItems = [
  { label: 'Beranda', href: '/id' },
  { label: 'Pelajari', current: true },
];
---

<BaseLayout
  title="Pelajari Ilmu Kebumian & Lingkungan"
  description="Inkuiri terstruktur, simulasi interaktif, dan pengalaman sains kebumian dunia nyata."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    <Breadcrumb items={breadcrumbItems} />

    <header class="border-b border-[var(--color-border)] pb-8 space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-accent)] font-bold">
        Pusat Pembelajaran
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-text)] tracking-tight">
        Kuasai Proses-Proses Kebumian
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] max-w-3xl leading-relaxed">
        Setiap pengalaman belajar mengikuti siklus inkuiri: <strong class="text-[var(--color-text)]">Rasa Ingin Tahu → Konsep → Proses → Simulasi → Dunia Nyata → Evaluasi → Refleksi</strong>.
      </p>
    </header>

    <!-- Featured Experience Hero Banner -->
    <section class="rounded-2xl border border-[var(--color-accent)]/30 bg-[var(--color-accent-subtle)]/30 p-6 sm:p-10 space-y-6">
      <div class="max-w-2xl space-y-3">
        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-[var(--color-accent)] text-white">
          Pengalaman Unggulan • Standar Referensi
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)]">
          Mengapa Gunung Api Terbentuk?
        </h2>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          Selami Palung Jawa yang dalam dan selidiki bagaimana lempeng samudra melepaskan fluida air ke astenosfer yang panas, memicu pelelehan fluks dan memberi daya bagi stratovulkan aktif seperti Gunung Merapi.
        </p>
      </div>

      <div class="flex items-center gap-3 flex-wrap">
        <Button href="/id/learn/why-volcanoes-form" variant="primary" size="md">
          Mulai Pengalaman Unggulan (20 mnt)
        </Button>
        <Button href="/id/explore/topics/plate-tectonics" variant="outline" size="md">
          Jelajahi Topik Tektonik Lempeng
        </Button>
      </div>
    </section>

    <!-- All Experiences Directory -->
    <section class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-[var(--color-text)]">
          Semua Pengalaman Interaktif
        </h2>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1">
          Jelajahi secara bebas tanpa prasyarat atau batasan yang mengunci.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {experiences.map((exp) => {
          const expSlug = (exp.data.id || exp.id).replace(/^id\//, '');
          return (
            <LearningCard
              id={expSlug}
              slug={expSlug}
              title={exp.data.title}
              tagline={exp.data.tagline}
              description={exp.data.description}
              topic={exp.data.topic}
              difficulty={exp.data.difficulty}
              estimatedTime={exp.data.estimatedTime}
              isIndonesiaFirst={exp.data.realWorldConnections?.[0]?.isIndonesiaFirst}
              hasInteractive={exp.data.interactiveElements?.length > 0}
              hasGeoMap={exp.data.geoMapConnections?.length > 0}
              locale="id"
            />
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

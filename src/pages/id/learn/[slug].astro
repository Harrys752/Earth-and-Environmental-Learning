---
import { getCollection, render } from 'astro:content';
import LearningLayout from '../../../layouts/LearningLayout.astro';

export async function getStaticPaths() {
  const experiences = await getCollection('experiences');
  const enExperiences = experiences.filter((e) => !e.id.startsWith('id/'));

  return enExperiences.map((enEntry) => {
    const slug = (enEntry.data.id || enEntry.id).replace(/^id\//, '');
    const idEntry = experiences.find((e) => e.id === `id/${slug}` || e.id === `id/${enEntry.id}`);

    if (idEntry) {
      return {
        params: { slug },
        props: { entry: idEntry, isFallback: false },
      };
    }

    return {
      params: { slug },
      props: { entry: enEntry, isFallback: true },
    };
  });
}

const { entry, isFallback = false } = Astro.props;
const { Content } = await render(entry);

const rawTopics = await getCollection('topics');
const idTopics = rawTopics.filter((t) => t.id.startsWith('id/'));
const topic = idTopics.find((t) => (t.data.id || t.id).replace(/^id\//, '') === entry.data.topic) ||
  rawTopics.find((t) => (t.data.id || t.id).replace(/^id\//, '') === entry.data.topic);

const topicTitle = topic?.data.title || entry.data.topic;
---

<LearningLayout
  title={entry.data.title}
  tagline={entry.data.tagline}
  description={entry.data.description}
  experienceSlug={(entry.data.id || entry.id).replace(/^id\//, '')}
  topicTitle={topicTitle}
  topicSlug={entry.data.topic}
  difficulty={entry.data.difficulty}
  estimatedTime={entry.data.estimatedTime}
  scientific={entry.data.scientific}
  isFallback={isFallback}
  locale="id"
>
  <Content />
</LearningLayout>

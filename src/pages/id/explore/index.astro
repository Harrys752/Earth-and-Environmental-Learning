---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import { withBase } from '../../../lib/url';

const breadcrumbItems = [
  { label: 'Beranda', href: '/id' },
  { label: 'Jelajahi', current: true },
];
---

<BaseLayout
  title="Jelajahi Ilmu Kebumian & Lingkungan"
  description="Telusuri topik sains, pengalaman belajar langkah demi langkah, dan penemuan lapangan di Indonesia."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    <Breadcrumb items={breadcrumbItems} />

    <header class="border-b border-[var(--color-border)] pb-8 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent)]/30">
        <span>Katalog Pembelajaran</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-text)] tracking-tight">
        Jelajahi Basis Pengetahuan Kebumian
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] max-w-3xl leading-relaxed">
        Pilih jalur eksplorasi: telusuri domain topik keplanetan, modul pengalaman belajar interaktif, atau hubungkan dengan peta geospasial.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {/* Topics Portal */}
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 space-y-4 hover:border-[var(--color-secondary)] transition-all">
        <div class="w-12 h-12 rounded-xl bg-[var(--color-secondary-subtle)] text-[var(--color-secondary)] flex items-center justify-center font-bold">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Domain Topik Sains</h2>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
          Studi komprehensif tentang tektonik lempeng, atmosfer, geologi batuan, dan bahaya alam.
        </p>
        <a
          href={withBase('/id/explore/topics')}
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-secondary)] hover:underline pt-2"
        >
          <span>Telusuri Semua Topik</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>

      {/* Experiences Portal */}
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 space-y-4 hover:border-[var(--color-accent)] transition-all">
        <div class="w-12 h-12 rounded-xl bg-[var(--color-accent-subtle)] text-[var(--color-accent)] flex items-center justify-center font-bold">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Pengalaman Belajar</h2>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
          Modul inkuiri interaktif langkah demi langkah dengan simulasi parameter fisik dan evaluasi pemahaman.
        </p>
        <a
          href={withBase('/id/explore/experiences')}
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-accent)] hover:underline pt-2"
        >
          <span>Buka Semua Pengalaman</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>

      {/* GeoMap Portal */}
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 space-y-4 hover:border-[var(--color-interactive)] transition-all">
        <div class="w-12 h-12 rounded-xl bg-[var(--color-interactive-subtle)] text-[var(--color-interactive)] flex items-center justify-center font-bold">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Jembatan GeoMap</h2>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
          Hubungkan teori kebumian ke koordinat geospasial nyata dengan visualisasi spasial interaktif GeoMap.
        </p>
        <a
          href={withBase('/id/geomap')}
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-interactive)] hover:underline pt-2"
        >
          <span>Buka Jembatan GeoMap</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';

const breadcrumbItems = [
  { label: 'Beranda', href: '/id' },
  { label: 'Tentang', current: true },
];
---

<BaseLayout
  title="Tentang Platform — Tujuan, Pedagogi & Etika Sains"
  description="Pelajari misi kami dalam mengubah Ilmu Kebumian & Lingkungan menjadi inkuiri interaktif berbasis narasi tanpa ketergantungan server."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    <Breadcrumb items={breadcrumbItems} />

    <header class="border-b border-[var(--color-border)] pb-8 space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-accent)] font-bold">
        Misi & Arsitektur
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-text)] tracking-tight">
        Tentang Platform Ilmu Kebumian
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] max-w-3xl leading-relaxed">
        Platform pembelajaran Ilmu Kebumian & Lingkungan interaktif berbasis narasi yang mengubah konsep-konsep sains menjadi pengalaman nyata yang dapat dijelajahi, dipahami, diterapkan, dan dihubungkan dengan alam sekitar.
      </p>
    </header>

    <!-- Core Philosophy -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-[var(--color-text)]">
        Mengapa Platform Ini Diciptakan
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        Pendidikan Ilmu Kebumian konvensional sering kali terpecah-pecah. Pembelajar menghafal definisi tanpa memahami proses fisik di baliknya, melihat diagram penampang statis tanpa tahu bagaimana lempeng bergerak melintasi waktu geologis, atau membaca peta tanpa konteks geologi.
      </p>
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        Platform ini menyatukan <strong class="text-[var(--color-text)]">pengetahuan + visualisasi + interaksi + geografi + aplikasi + refleksi</strong> ke dalam satu pengalaman utuh yang dipandu oleh siklus inkuiri berkelanjutan:
      </p>

      <div class="p-4 rounded-xl bg-[var(--color-surface-hover)] border border-[var(--color-border)] font-mono text-xs text-[var(--color-accent)] font-bold text-center">
        Ingin Tahu → Bertanya → Jelajahi → Pelajari → Berinteraksi → Pahami → Uji → Terapkan → Amati → Refleksikan → Jelajahi Lagi
      </div>
    </section>

    <!-- Indonesia-First Perspective -->
    <section class="p-6 rounded-2xl border border-[var(--color-secondary)]/30 bg-[var(--color-secondary-subtle)]/30 space-y-3">
      <h3 class="text-lg font-bold text-[var(--color-text)]">
        🇮🇩 Perspektif Geografis Indonesia-First
      </h3>
      <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
        Indonesia adalah laboratorium geologi hidup. Berada di zona tabrakan lempeng Indo-Australia, Sunda (Eurasia), dan Pasifik, kepulauan ini memiliki busur vulkanik aktif, palung samudra yang dalam, iklim mikro hutan hujan tropis, dan kompleks akresi kelas dunia.
      </p>
      <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
        Platform kami melabuhkan konsep keplanetan abstrak pada lokasi nyata di Indonesia—dari Gunung Merapi dan Palung Jawa hingga Geopark Karangsambung dan sabuk hujan Bogor—sebelum memperluasnya ke sistem Bumi global.
      </p>
    </section>

    <!-- Scientific Sources & Illustrative Model Disclosures (§17.3) -->
    <section id="illustrative-models" class="space-y-4 pt-4 border-t border-[var(--color-border)]">
      <h2 class="text-2xl font-bold text-[var(--color-text)]">
        Integritas Sains & Keterbukaan Model
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        Kami mematuhi standar integritas ilmiah yang ketat:
      </p>
      <ul class="space-y-2 text-xs sm:text-sm text-[var(--color-text-muted)] list-disc list-inside">
        <li><strong>Sumber Primer:</strong> Konten disintesis dari literatur ilmiah tertinjau sejawat, buku teks geologi universitas, USGS, Badan Geologi / PVMBG Indonesia, BMKG, dan UNESCO.</li>
        <li><strong>Pembedaan Model dari Realitas:</strong> Simulasi interaktif secara eksplisit diberi label sebagai <span class="px-2 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-300 dark:bg-amber-950 dark:text-amber-200 font-mono text-xs">Model Ilustratif</span> untuk mengilustrasikan prinsip dasar fisika (seperti pelelehan fluks) dalam kinematika 2D yang disederhanakan.</li>
        <li><strong>Tanpa Presisi Semu:</strong> Kami menghindari angka desimal buatan atau skor numerik artifisial. Penguasaan materi direpresentasikan melalui indikator kualitatif berdasarkan latihan sadar dan kedalaman inkuiri.</li>
      </ul>
    </section>

    <!-- Privacy & Static Infrastructure (§1.6 / 10.4) -->
    <section class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] space-y-3">
      <h3 class="text-lg font-bold text-[var(--color-text)]">
        Privasi & Nol Infrastruktur Server
      </h3>
      <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
        Platform ini berjalan sepenuhnya sebagai file statis yang di-host di GitHub Pages. Tidak memerlukan server backend, database, maupun pelacak analitik pihak ketiga.
      </p>
      <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
        <strong class="text-[var(--color-text)]">Semua progres, skor kuis, refleksi, dan catatan lapangan tersimpan 100% secara lokal di browser web Anda.</strong> Anda dapat mengekspor atau menghapus data Anda kapan saja.
      </p>
    </section>

    <div class="pt-4 flex items-center gap-3">
      <Button href="/id/explore" variant="primary" size="md">
        Mulai Jelajahi Sains Kebumian
      </Button>
      <Button href="/id/journey" variant="outline" size="md">
        Buka Linimasa Jurnal
      </Button>
    </div>
  </div>
</BaseLayout>

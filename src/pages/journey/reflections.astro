---
import JourneyLayout from '../../layouts/JourneyLayout.astro';
import ReflectionsViewer from '../../components/journey/ReflectionsViewer';
---

<JourneyLayout
  title="Scientific Reflections Archive"
  description="All reflections, real-world field hypotheses, and personal inquiry notes logged during your learning experiences."
  activeTab="reflections"
>
  <div class="space-y-6">
    <div class="flex items-center justify-between border-b border-[var(--color-border)] pb-3">
      <h2 class="text-lg font-bold text-[var(--color-text)]">
        Logged Reflections
      </h2>
      <span class="text-xs text-[var(--color-text-dim)] font-mono">
        Saved locally in browser
      </span>
    </div>

    <ReflectionsViewer client:visible />
  </div>
</JourneyLayout>

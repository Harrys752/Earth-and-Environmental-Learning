---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { withBase } from '../../lib/base';
import GeoMapLink from '../../components/geomap/GeoMapLink.astro';

const concepts = await getCollection('concepts');

const breadcrumbItems = [
  { label: 'Explore', href: '/explore' },
  { label: 'Field Discoveries', current: true },
];
---

<BaseLayout
  title="Field Discoveries & Real-World Earth Phenomena"
  description="Discover curated real-world Earth phenomena, geological field sites across Indonesia, and core scientific concepts."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    <Breadcrumb items={breadcrumbItems} />

    <header class="border-b border-[var(--color-border)] pb-8 space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-secondary)] font-bold">
        Tangible Earth Evidence
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-text)] tracking-tight">
        Real-World Discoveries
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] max-w-3xl leading-relaxed">
        Earth science is not confined to abstract laboratory diagrams. It is written into the mountain peaks, volcanic arcs, and stratigraphy of the planet.
      </p>
    </header>

    <!-- Geological Field Sites & Anchors -->
    <section class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-[var(--color-text)]">
          Indonesian Geological Field Sites
        </h2>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1">
          Explore key field localities connected to our learning experiences via GeoMap Indonesia.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <GeoMapLink
          locationSlug="java-volcanic-arc"
          label="Java Volcanic Arc & Mount Merapi"
          coordinates={{ lat: -7.5407, lng: 110.4457 }}
          description="Active andesitic stratovolcano exhibiting pyroclastic flows, lava domes, and active subduction-driven hazard zones."
        />
        <GeoMapLink
          locationSlug="karangsambung-geopark"
          label="Karangsambung Geopark (Luk Ulo River)"
          coordinates={{ lat: -7.5614, lng: 109.6814 }}
          description="Ancient Cretaceous subduction mélange with exposed deep-ocean pillow basalts and blueschist uplifted onto land."
        />
        <GeoMapLink
          locationSlug="bogor-rain-belt"
          label="Bogor Orographic Rain Belt"
          coordinates={{ lat: -6.5971, lng: 106.806 }}
          description="Tropical rainfall hotspot demonstrating orographic lifting against Mount Salak and Mount Gede-Pangrango."
        />
        <GeoMapLink
          locationSlug="sangiran-valley"
          label="Sangiran Early Man Valley"
          coordinates={{ lat: -7.4589, lng: 110.8319 }}
          description="Exemplary sedimentary stratigraphy containing 2 million years of Pleistocene hominid and fauna fossils."
        />
      </div>
    </section>

    <!-- Core Concepts Glossary Grid -->
    <section class="space-y-6 pt-6 border-t border-[var(--color-border)]">
      <div>
        <h2 class="text-2xl font-bold text-[var(--color-text)]">
          Core Scientific Concepts
        </h2>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1">
          Reference definitions, geodynamic mechanisms, and cross-experience connections.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {concepts.map((c) => (
          <article class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] transition-all flex flex-col justify-between">
            <div class="space-y-2">
              <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-accent)] font-semibold">
                {c.data.domain}
              </span>
              <h3 class="text-base font-bold text-[var(--color-text)]">
                <a href={withBase(`/learn/concepts/${c.data.id || c.id}`)} class="hover:underline">
                  {c.data.title}
                </a>
              </h3>
              <p class="text-xs text-[var(--color-text-muted)] line-clamp-3 leading-relaxed">
                {c.data.summary}
              </p>
            </div>

            <div class="pt-3 mt-3 border-t border-[var(--color-border)] text-xs text-[var(--color-text-dim)] flex items-center justify-between">
              <span>{c.data.relatedExperiences.length} related experience</span>
              <a
                href={withBase(`/learn/concepts/${c.data.id || c.id}`)}
                class="font-semibold text-[var(--color-accent)] hover:underline"
              >
                Inspect →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

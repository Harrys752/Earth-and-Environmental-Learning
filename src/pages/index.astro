---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/learning/TopicCard.astro';
import LearningCard from '../components/learning/LearningCard.astro';
import Button from '../components/ui/Button.astro';

const topics = await getCollection('topics');
const experiences = await getCollection('experiences');
const flagshipExp = experiences.find((e) => (e.data.id || e.id) === 'why-volcanoes-form') || experiences[0];
---

<BaseLayout title="Earth & Environmental Sciences — Interactive Learning Platform">
  <!-- Hero / Curiosity Section (§15.1) -->
  <section class="relative overflow-hidden border-b border-[var(--color-border)] bg-gradient-to-b from-[var(--color-surface)] to-[var(--color-background)] py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[var(--color-accent-subtle)] text-[var(--color-accent)] border border-[var(--color-accent)]/30">
          <span class="w-2 h-2 rounded-full bg-[var(--color-accent)] animate-pulse" />
          <span>Interactive Scientific Exploration • V1</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[var(--color-text)] tracking-tight leading-[1.1]">
          Explore the Living Engine of Planet Earth.
        </h1>

        <p class="text-base sm:text-xl text-[var(--color-text-muted)] leading-relaxed">
          From deep subduction zones fueling explosive volcanic arcs to equatorial cloud physics over Indonesia, understand Earth’s dynamic processes through interactive models, real-world field anchors, and your personal scientific journey.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <Button href="/learn/why-volcanoes-form" variant="primary" size="lg">
            <span>Explore Flagship: Why Do Volcanoes Form?</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </Button>

          <Button href="/explore" variant="outline" size="lg">
            <span>Browse All Topics</span>
          </Button>
        </div>

        <!-- Curiosity Prompt Card -->
        <div class="mt-8 p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/80 backdrop-blur text-xs flex items-start gap-3 max-w-xl">
          <div class="w-7 h-7 rounded-lg bg-[var(--color-accent)] text-white flex items-center justify-center shrink-0 font-bold">
            ?
          </div>
          <div>
            <div class="font-bold text-[var(--color-text)]">Curiosity Trigger:</div>
            <div class="text-[var(--color-text-muted)] leading-relaxed mt-0.5">
              "Why is Mount Merapi in Central Java located nearly 300 kilometers north of the offshore oceanic trench where plates collide?"
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <!-- Continue Learning / Discovery Branch (§15.1) -->
    <section class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--color-border)] pb-6 mb-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-accent)] font-semibold">
            Featured Inquiry
          </span>
          <h2 class="text-2xl font-bold text-[var(--color-text)] mt-0.5">
            Recommended Starting Point
          </h2>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1">
            Start with our reference-quality flagship experience connecting subduction kinematics to real Indonesian volcanoes.
          </p>
        </div>

        <Button href={`/learn/${flagshipExp.data.id || flagshipExp.id}`} variant="primary" size="md">
          Begin Experience
        </Button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-4">
          <h3 class="text-xl font-bold text-[var(--color-text)]">
            {flagshipExp.data.title}
          </h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            {flagshipExp.data.description}
          </p>
          <div class="space-y-2">
            <span class="text-xs font-semibold text-[var(--color-text)] block">
              Core Inquiries Explored:
            </span>
            <ul class="space-y-1.5 text-xs text-[var(--color-text-muted)] list-disc list-inside">
              {flagshipExp.data.learningObjectives.slice(0, 3).map((obj) => (
                <li>{obj}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="rounded-xl border border-[var(--color-secondary)]/30 bg-[var(--color-secondary-subtle)]/40 p-5 space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-secondary)] font-bold">
              Real-World Anchor
            </span>
            <h4 class="text-sm font-bold text-[var(--color-text)]">
              Java Volcanic Arc & Mount Merapi
            </h4>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
              Examine how Indo-Australian subduction drives explosive volcanism across Java and assess field hazards.
            </p>
          </div>

          <a
            href={`/learn/${flagshipExp.data.id || flagshipExp.id}`}
            class="text-xs font-bold text-[var(--color-secondary)] hover:underline inline-flex items-center gap-1 mt-2"
          >
            <span>Launch Interactive Simulation</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Explore Topics Grid (§15.1) -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-secondary)] font-semibold">
            Scientific Domains
          </span>
          <h2 class="text-2xl font-bold text-[var(--color-text)] mt-0.5">
            Explore Earth Science Topics
          </h2>
        </div>
        <a
          href="/explore/topics"
          class="text-xs font-semibold text-[var(--color-accent)] hover:underline inline-flex items-center gap-1"
        >
          <span>View all topics</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {topics.map((topic) => {
          const count = experiences.filter(
            (e) => e.data.topic === (topic.data.id || topic.id)
          ).length;
          return (
            <TopicCard
              slug={topic.data.id || topic.id}
              title={topic.data.title}
              tagline={topic.data.tagline}
              description={topic.data.description}
              category={topic.data.category}
              experienceCount={count}
            />
          );
        })}
      </div>
    </section>

    <!-- Recent Experiences Grid -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-interactive)] font-semibold">
            Learning Experiences
          </span>
          <h2 class="text-2xl font-bold text-[var(--color-text)] mt-0.5">
            Step-by-Step Scientific Inquiries
          </h2>
        </div>
        <a
          href="/explore/experiences"
          class="text-xs font-semibold text-[var(--color-interactive)] hover:underline inline-flex items-center gap-1"
        >
          <span>All experiences</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {experiences.map((exp) => (
          <LearningCard
            id={exp.data.id || exp.id}
            slug={exp.data.id || exp.id}
            title={exp.data.title}
            tagline={exp.data.tagline}
            description={exp.data.description}
            topic={exp.data.topic}
            difficulty={exp.data.difficulty}
            estimatedTime={exp.data.estimatedTime}
            isIndonesiaFirst={exp.data.realWorldConnections?.[0]?.isIndonesiaFirst}
            hasInteractive={exp.data.interactiveElements?.length > 0}
            hasGeoMap={exp.data.geoMapConnections?.length > 0}
          />
        ))}
      </div>
    </section>

    <!-- Journey Preview Banner (§15.1 / 15.7) -->
    <section class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-hover)] p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent)]" />
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-accent)] font-semibold">
            Personal Learning Portfolio
          </span>
        </div>
        <h3 class="text-xl font-bold text-[var(--color-text)]">
          Document Your Observations & Scientific Mastery
        </h3>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] max-w-xl leading-relaxed">
          Your progress, quiz evaluations, field notes, and reflections are automatically organized into your private chronological Journey timeline.
        </p>
      </div>

      <Button href="/journey" variant="secondary" size="md">
        <span>Open Journey Timeline</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </Button>
    </section>
  </div>
</BaseLayout>

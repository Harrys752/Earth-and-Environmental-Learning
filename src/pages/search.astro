---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import SearchBox from '../components/ui/SearchBox';

const breadcrumbItems = [
  { label: 'Search', current: true },
];
---

<BaseLayout
  title="Search Knowledge Base — Earth & Environmental Sciences"
  description="Client-side instant search across topics, learning experiences, scientific concepts, and real-world field locations."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    <Breadcrumb items={breadcrumbItems} />

    <header class="border-b border-[var(--color-border)] pb-6 space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] tracking-tight">
        Search Earth Sciences
      </h1>
      <p class="text-sm sm:text-base text-[var(--color-text-muted)] max-w-2xl leading-relaxed">
        Query our knowledge base by keyword, geological formation, Indonesian field anchor, or physical process.
      </p>
    </header>

    <SearchBox client:load />
  </div>
</BaseLayout>

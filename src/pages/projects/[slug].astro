---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.data.id || entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const breadcrumbItems = [
  { label: 'Journey', href: '/journey' },
  { label: 'Projects', href: '/journey/projects' },
  { label: entry.data.title, current: true },
];
---

<BaseLayout
  title={`${entry.data.title} — Earth Science Project`}
  description={entry.data.description}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    <Breadcrumb items={breadcrumbItems} />

    <header class="border-b border-[var(--color-border)] pb-8 space-y-4">
      <div class="flex items-center gap-2 flex-wrap text-xs">
        <span class="font-mono font-bold uppercase tracking-wider text-[var(--color-accent)]">
          Applied Investigation Project
        </span>
        <span class="text-[var(--color-border)]">•</span>
        <Badge variant={entry.data.difficulty}>{entry.data.difficulty}</Badge>
        <Badge variant="time">{entry.data.estimatedTime}</Badge>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-[var(--color-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-muted)] capitalize">
          {entry.data.deliverableType.replace('-', ' ')}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] tracking-tight">
        {entry.data.title}
      </h1>

      <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
        {entry.data.description}
      </p>

      <div class="pt-2">
        <Button href={`/learn/${entry.data.relatedExperienceSlug}`} variant="outline" size="sm">
          ← Revisit Prerequisite Experience: {entry.data.relatedExperienceSlug}
        </Button>
      </div>
    </header>

    <!-- Objectives & Instructions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider font-mono text-[var(--color-secondary)]">
          Investigation Objectives
        </h3>
        <ul class="space-y-2 text-xs text-[var(--color-text-muted)] list-disc list-inside">
          {entry.data.objectives.map((obj) => (
            <li class="leading-relaxed">{obj}</li>
          ))}
        </ul>
      </div>

      <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider font-mono text-[var(--color-accent)]">
          Execution Protocol
        </h3>
        <ol class="space-y-2 text-xs text-[var(--color-text-muted)] list-decimal list-inside">
          {entry.data.instructions.map((inst) => (
            <li class="leading-relaxed">{inst}</li>
          ))}
        </ol>
      </div>
    </div>

    <!-- Narrative Content -->
    <article class="prose prose-stone dark:prose-invert max-w-none pt-4 border-t border-[var(--color-border)]">
      <Content />
    </article>

    <!-- Log into Journey Built Dimension -->
    <div class="p-6 rounded-2xl border border-[var(--color-interactive)]/30 bg-[var(--color-interactive-subtle)]/30 space-y-4">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-[var(--color-interactive)] text-white flex items-center justify-center font-bold">
          ★
        </div>
        <h3 class="text-base font-bold text-[var(--color-text)]">
          Record Completed Project Output
        </h3>
      </div>
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
        Completed this investigation? Log your findings and conclusions into your Journey to unlock the "Built" indicator for this domain.
      </p>
      <Button
        href={`/journey/timeline?action=new&type=built&title=${encodeURIComponent(entry.data.title)}`}
        variant="primary"
        size="sm"
      >
        Log Project in Journey
      </Button>
    </div>
  </div>
</BaseLayout>

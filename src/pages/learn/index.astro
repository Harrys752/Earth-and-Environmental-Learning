---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import LearningCard from '../../components/learning/LearningCard.astro';
import Button from '../../components/ui/Button.astro';

const experiences = await getCollection('experiences');

const breadcrumbItems = [
  { label: 'Learn', current: true },
];
---

<BaseLayout
  title="Learn Earth & Environmental Sciences"
  description="Structured inquiries, interactive simulations, and real-world Earth science experiences."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    <Breadcrumb items={breadcrumbItems} />

    <header class="border-b border-[var(--color-border)] pb-8 space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-accent)] font-bold">
        Learning Center
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-text)] tracking-tight">
        Master Earth Processes
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] max-w-3xl leading-relaxed">
        Every experience follows our core learning loop: <strong class="text-[var(--color-text)]">Curiosity → Concept → Process → Simulation → Real World → Assessment → Reflection</strong>.
      </p>
    </header>

    <!-- Featured Experience Hero Banner -->
    <section class="rounded-2xl border border-[var(--color-accent)]/30 bg-[var(--color-accent-subtle)]/30 p-6 sm:p-10 space-y-6">
      <div class="max-w-2xl space-y-3">
        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-[var(--color-accent)] text-white">
          Flagship Experience • Reference Standard
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)]">
          Why Do Volcanoes Form?
        </h2>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          Plunge into the deep Java Trench and investigate how subducting oceanic slabs release water into the scorching asthenosphere, triggering flux melting and powering explosive stratovolcanoes like Mount Merapi.
        </p>
      </div>

      <div class="flex items-center gap-3 flex-wrap">
        <Button href="/learn/why-volcanoes-form" variant="primary" size="md">
          Start Flagship Experience (20 min)
        </Button>
        <Button href="/explore/topics/plate-tectonics" variant="outline" size="md">
          Explore Plate Tectonics Topic
        </Button>
      </div>
    </section>

    <!-- All Experiences Directory -->
    <section class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-[var(--color-text)]">
          All Interactive Experiences
        </h2>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1">
          Explore freely without prerequisites or locks.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {experiences.map((exp) => (
          <LearningCard
            id={exp.data.id || exp.id}
            slug={exp.data.id || exp.id}
            title={exp.data.title}
            tagline={exp.data.tagline}
            description={exp.data.description}
            topic={exp.data.topic}
            difficulty={exp.data.difficulty}
            estimatedTime={exp.data.estimatedTime}
            isIndonesiaFirst={exp.data.realWorldConnections?.[0]?.isIndonesiaFirst}
            hasInteractive={exp.data.interactiveElements?.length > 0}
            hasGeoMap={exp.data.geoMapConnections?.length > 0}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

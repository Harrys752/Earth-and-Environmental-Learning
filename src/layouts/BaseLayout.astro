---
import '../styles/global.css';
import ThemeToggle from '../components/ui/ThemeToggle';
import { withBase } from '../lib/url';

export interface Props {
  title: string;
  description?: string;
  ogType?: string;
  canonicalUrl?: string;
  class?: string;
}

const {
  title,
  description = 'Interactive, narrative-driven Earth & Environmental Sciences learning platform connecting concepts, simulations, and real-world Earth phenomena.',
  ogType = 'website',
  canonicalUrl,
  class: className = '',
} = Astro.props;

const fullTitle = title.includes('Earth Learning')
  ? title
  : `${title} | Earth & Environmental Sciences`;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  const target = withBase(path);
  if (path === '/' && (currentPath === base || currentPath === base.slice(0, -1) || currentPath === '/')) return true;
  if (path !== '/' && currentPath.startsWith(target)) return true;
  return false;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / SEO -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <title>{fullTitle}</title>

    <!-- Theme Initialization Script to prevent flash -->
    <script is:inline>
      (function() {
        try {
          const raw = localStorage.getItem('earth_learning_v1_state');
          if (raw) {
            const parsed = JSON.parse(raw);
            const theme = parsed?.preferences?.theme || 'system';
            if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
              document.documentElement.setAttribute('data-theme', 'dark');
            } else {
              document.documentElement.setAttribute('data-theme', 'light');
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-canvas text-main min-h-screen flex flex-col selection:bg-[var(--color-accent-subtle)] selection:text-[var(--color-accent)]">
    <!-- Skip to Main Content Link for Accessibility (§19) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 rounded-lg bg-[var(--color-accent)] text-white font-semibold text-xs shadow-lg"
    >
      Skip to main content
    </a>

    <!-- Global Navigation Header -->
    <header class="sticky top-0 z-40 w-full border-b border-[var(--color-border)] bg-[var(--color-background)]/90 backdrop-blur-md transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        {/* Brand Logo & Tagline */}
        <div class="flex items-center gap-3">
          <a href={withBase('/')} class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded-lg p-1">
            <div class="w-8 h-8 rounded-xl bg-[var(--color-accent)] text-white flex items-center justify-center font-bold text-sm shadow-sm group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                <path d="M2 12h20" />
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="font-extrabold text-sm sm:text-base text-[var(--color-text)] tracking-tight leading-none group-hover:text-[var(--color-accent)] transition-colors">
                Earth & Environment
              </span>
              <span class="text-[10px] font-mono text-[var(--color-text-dim)] leading-tight hidden sm:block">
                Inquiry • Process • Reality
              </span>
            </div>
          </a>
        </div>

        {/* Primary Desktop Navigation Links (§3.2) */}
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium" aria-label="Main Navigation">
          <a
            href={withBase('/')}
            class={`px-3 py-1.5 rounded-lg transition-colors ${
              isActive('/')
                ? 'text-[var(--color-accent)] font-semibold bg-[var(--color-accent-subtle)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-hover)]'
            }`}
          >
            Home
          </a>
          <a
            href={withBase('/explore')}
            class={`px-3 py-1.5 rounded-lg transition-colors ${
              isActive('/explore')
                ? 'text-[var(--color-accent)] font-semibold bg-[var(--color-accent-subtle)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-hover)]'
            }`}
          >
            Explore
          </a>
          <a
            href={withBase('/learn')}
            class={`px-3 py-1.5 rounded-lg transition-colors ${
              isActive('/learn')
                ? 'text-[var(--color-accent)] font-semibold bg-[var(--color-accent-subtle)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-hover)]'
            }`}
          >
            Learn
          </a>
          <a
            href={withBase('/journey')}
            class={`px-3 py-1.5 rounded-lg transition-colors ${
              isActive('/journey')
                ? 'text-[var(--color-accent)] font-semibold bg-[var(--color-accent-subtle)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-hover)]'
            }`}
          >
            Journey
          </a>
          <a
            href={withBase('/geomap')}
            class={`px-3 py-1.5 rounded-lg transition-colors ${
              isActive('/geomap')
                ? 'text-[var(--color-interactive)] font-semibold bg-[var(--color-interactive-subtle)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-interactive)] hover:bg-[var(--color-surface-hover)]'
            }`}
          >
            GeoMap Bridge
          </a>
          <a
            href={withBase('/about')}
            class={`px-3 py-1.5 rounded-lg transition-colors ${
              isActive('/about')
                ? 'text-[var(--color-accent)] font-semibold bg-[var(--color-accent-subtle)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-hover)]'
            }`}
          >
            About
          </a>
        </nav>

        {/* Global Utilities: Search Icon & Theme Toggle Island */}
        <div class="flex items-center gap-2">
          <a
            href={withBase('/search')}
            class="w-9 h-9 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-hover)] flex items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
            title="Search topics, experiences, and concepts (Shortcut)"
            aria-label="Search earth sciences knowledge base"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </a>

          <ThemeToggle client:idle />

          {/* Mobile Menu Trigger */}
          <div class="md:hidden flex items-center">
            <a
              href={withBase('/explore')}
              class="px-2.5 py-1.5 rounded-lg border border-[var(--color-border)] text-xs font-semibold text-[var(--color-text-muted)]"
            >
              Menu
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Landmark -->
    <main id="main-content" class={`flex-1 ${className}`}>
      <slot />
    </main>

    <!-- Global Educational Footer -->
    <footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)] py-12 text-xs text-[var(--color-text-muted)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="space-y-3 md:col-span-2">
            <div class="flex items-center gap-2 font-bold text-sm text-[var(--color-text)]">
              <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent)]" />
              <span>Earth & Environmental Sciences Learning Platform</span>
            </div>
            <p class="leading-relaxed max-w-md">
              A narrative-driven, inquiry-based web platform turning planetary processes into interactive experiences. Built with zero required server runtimes, hostable entirely on static infrastructure.
            </p>
            <div class="text-[11px] font-mono text-[var(--color-text-dim)]">
              Guest-First Architecture • Progress stored 100% locally in your browser.
            </div>
          </div>

          <div class="space-y-2">
            <h4 class="font-bold uppercase tracking-wider text-[var(--color-text)] text-[11px] font-mono">
              Exploration
            </h4>
            <ul class="space-y-1.5 list-none p-0 m-0">
              <li><a href={withBase('/explore/topics')} class="hover:text-[var(--color-text)]">All Topics</a></li>
              <li><a href={withBase('/explore/experiences')} class="hover:text-[var(--color-text)]">Learning Experiences</a></li>
              <li><a href={withBase('/learn/why-volcanoes-form')} class="hover:text-[var(--color-text)]">Volcanism Flagship</a></li>
              <li><a href={withBase('/geomap')} class="hover:text-[var(--color-interactive)]">GeoMap Bridge</a></li>
            </ul>
          </div>

          <div class="space-y-2">
            <h4 class="font-bold uppercase tracking-wider text-[var(--color-text)] text-[11px] font-mono">
              Scientific Ethics
            </h4>
            <ul class="space-y-1.5 list-none p-0 m-0">
              <li><a href={withBase('/about')} class="hover:text-[var(--color-text)]">Sources & Pedagogy</a></li>
              <li><a href={withBase('/about#illustrative-models')} class="hover:text-[var(--color-text)]">Model Disclosures</a></li>
              <li><a href={withBase('/journey')} class="hover:text-[var(--color-text)]">Personal Journey</a></li>
              <li><a href={withBase('/search')} class="hover:text-[var(--color-text)]">Knowledge Search</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-6 border-t border-[var(--color-border)] flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-[var(--color-text-dim)]">
          <div>
            Earth Science Learning Platform (V1). Open scientific education.
          </div>
          <div class="flex items-center gap-4">
            <a href={withBase('/about')} class="hover:underline">About</a>
            <a href={withBase('/geomap')} class="hover:underline">GeoMap Indonesia 2.0 (External)</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

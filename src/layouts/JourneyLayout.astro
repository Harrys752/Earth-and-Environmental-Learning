---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb, { type BreadcrumbItem } from '../components/ui/Breadcrumb.astro';
import { withBase } from '../lib/url';

export interface Props {
  title: string;
  description?: string;
  activeTab?: 'overview' | 'timeline' | 'reflections' | 'projects';
  locale?: 'en' | 'id';
}

const {
  title,
  description = 'Your personal Earth & Environmental Sciences learning timeline, reflections, and field observations.',
  activeTab = 'overview',
  locale = 'en',
} = Astro.props;

const isId = locale === 'id';

const tabs = isId
  ? [
      { id: 'overview', label: 'Ringkasan Dasbor', href: '/id/journey' },
      { id: 'timeline', label: 'Linimasa & Log', href: '/id/journey/timeline' },
      { id: 'reflections', label: 'Refleksi', href: '/id/journey/reflections' },
      { id: 'projects', label: 'Proyek Terapan', href: '/id/journey/projects' },
    ]
  : [
      { id: 'overview', label: 'Overview Dashboard', href: '/journey' },
      { id: 'timeline', label: 'Timeline & Logs', href: '/journey/timeline' },
      { id: 'reflections', label: 'Reflections', href: '/journey/reflections' },
      { id: 'projects', label: 'Built Projects', href: '/journey/projects' },
    ];

const breadcrumbItems: BreadcrumbItem[] = [
  { label: isId ? 'Jurnal' : 'Journey', href: isId ? '/id/journey' : '/journey', current: activeTab === 'overview' },
];

if (activeTab !== 'overview') {
  const activeObj = tabs.find((t) => t.id === activeTab);
  breadcrumbItems.push({
    label: activeObj?.label || (isId ? 'Bagian' : 'Section'),
    href: activeObj?.href,
    current: true,
  });
}
---

<BaseLayout title={title} description={description} locale={locale}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumb items={breadcrumbItems} class="mb-4" />

    <header class="border-b border-[var(--color-border)] pb-6 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-accent)] font-bold">
            Learner Portfolio & Scientific History
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] tracking-tight mt-1">
            {title}
          </h1>
          <p class="text-sm text-[var(--color-text-muted)] mt-1.5 max-w-2xl leading-relaxed">
            {description}
          </p>
        </div>

        <div class="text-[11px] font-mono px-3 py-1.5 rounded-lg bg-[var(--color-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-dim)] self-start sm:self-auto shrink-0">
          🔒 Private Local Storage
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex items-center gap-2 overflow-x-auto pt-6" aria-label="Journey Navigation">
        {tabs.map((tab) => {
          const isCurrent = activeTab === tab.id;
          return (
            <a
              href={withBase(tab.href)}
              class={`px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all ${
                isCurrent
                  ? 'bg-[var(--color-accent)] text-white shadow-sm'
                  : 'bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-hover)]'
              }`}
            >
              {tab.label}
            </a>
          );
        })}
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </div>
</BaseLayout>
